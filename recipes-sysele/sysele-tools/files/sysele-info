#!/bin/sh
# Print the build banner and the tools this package ships, on demand.
# The banner alone is what the login shell shows.

SYSELE_DIR=${SYSELE_DIR:-/opt/sysele}

if [ ! -r "$SYSELE_DIR/share/build-info" ]; then
    echo "sysele-info: $SYSELE_DIR/share/build-info is missing" >&2
    exit 1
fi

cat "$SYSELE_DIR/share/build-info"

# The one line description lives in the file itself: line 2 of a shell tool,
# under the shebang, and line 1 of the source of a compiled one.
describe() {
    case "$(head -c 2 "$1")" in
        "#!") sed -n '2s|^# \{0,1\}||p' "$1" ;;
        *)    sed -n '1s|^// \{0,1\}||p' "$SYSELE_DIR/src/$(basename "$1").c" 2>/dev/null ;;
    esac
}

echo "  commands, on the PATH"
for t in "$SYSELE_DIR"/bin/*; do
    [ -x "$t" ] || continue
    n=$(basename "$t")
    [ "$n" = "sysele-info" ] && continue
    printf "    %-14s %s\n" "$n" "$(describe "$t")"
done

if [ -d "$SYSELE_DIR/diagnostics" ]; then
    echo
    echo "  instruments, off the PATH, in $SYSELE_DIR/diagnostics"
    printf "   "
    for t in "$SYSELE_DIR"/diagnostics/*; do
        [ -x "$t" ] && printf " %s" "$(basename "$t")"
    done
    echo
fi

echo
if [ -d "$SYSELE_DIR/apps" ]; then
    echo "  applications, in $SYSELE_DIR/apps, started by the commands above"
    printf "   "
    for a in "$SYSELE_DIR"/apps/*/*; do
        [ -d "$a" ] && printf " %s/%s" "$(basename "$(dirname "$a")")" "$(basename "$a")"
    done
    echo
fi
echo "  sources in $SYSELE_DIR/src, configuration in $SYSELE_DIR/etc, generated files in $SYSELE_DIR/var"
echo
