#!/bin/sh
# Start the demo on the DSI panel: camera, auto exposure, video on screen.
# Usage: dsi_demo [seconds]    with no argument it runs until stopped
# The knobs are in etc/camera_ae.conf, under /opt/sysele.
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac

SYSELE_DIR=${SYSELE_DIR:-/opt/sysele}
CONF=${CAMERA_AE_CONF:-$SYSELE_DIR/etc/camera_ae.conf}
JSON=${SYSELE_JSON:-$SYSELE_DIR/var/frontend_dsi_30.json}
AAA=${SYSELE_3ACONFIG:-/usr/bin/3aconfig.json}
DUR=$1

AE_MODE=native; AE_FIXED_US=10000; FLICKER=0
[ -r "$CONF" ] && . "$CONF"
say() { echo "dsi_demo: $*"; }

# The camera JSON follows the connected panel: dsi_config rewrites it only when
# it is missing or sized for another panel. A JSON given in SYSELE_JSON is used
# as it is.
[ -n "${SYSELE_JSON:-}" ] || "$SYSELE_DIR/bin/dsi_config" --if-stale || exit 1

# 1. the camera. Model, CSI receiver and I2C bus come from the media graph, and
# the ISP files are pointed at it: an IMX678 or an IMX334 on either connector.
# A wrong bus is invisible: the auto exposure writes to an empty bus, nobody
# complains and the image burns out.
CAMERA=$("$SYSELE_DIR/bin/sysele-camera" --prepare --shell) || exit 1
eval "$CAMERA"
SENSOR=$SENSOR_NAME; SUBDEV=$SENSOR_SUBDEV; BUS=$SENSOR_BUS
ISP=""; for n in /sys/class/video4linux/v4l-subdev*; do
    case "$(cat "$n/name" 2>/dev/null)" in hailo-isp*) ISP="/dev/$(basename "$n")" ;; esac
done
# The fixed exposure below writes IMX678 registers and line times.
if [ "$AE_MODE" = "fixed" ] && [ "$SENSOR_MODEL" != "imx678" ]; then
    say "fixed exposure is implemented for the IMX678 only; using the native auto exposure on the $SENSOR_MODEL"
    AE_MODE=native
fi

# 2. the knobs. Flicker goes into the 3A config only when it really changes.
if [ -w "$AAA" ]; then
    FCUR=$(sed -n 's/.*"flickerPeriod" *: *\([0-9]*\).*/\1/p' "$AAA" | head -1)
    if [ "$FCUR" != "$FLICKER" ]; then
        say "flicker: $FCUR to $FLICKER"
        sed "s|\"flickerPeriod\" *: *[0-9]*|\"flickerPeriod\" : $FLICKER|" "$AAA" > "$AAA.new" && mv "$AAA.new" "$AAA"
    fi
fi

[ -f "$JSON" ] || { say "$JSON is missing, run dsi_config"; exit 1; }
say "$SENSOR_MODEL on CSI-RX$SENSOR_INDEX, i2c-$BUS, mode $AE_MODE, flicker $FLICKER, source $JSON"

# 3. the pipeline.
if [ -n "$DUR" ]; then T="timeout -k 5 -s INT $DUR"; else T=""; fi
$T gst-launch-1.0 hailofrontendbinsrc config-file-path=$JSON name=fe \
  fe.src_0 ! queue leaky=downstream max-size-buffers=5 ! videoconvert n-threads=4 ! \
  video/x-raw,format=BGR ! \
  fpsdisplaysink video-sink="kmssink driver-name=hailo-drm force-modesetting=true can-scale=false" \
  text-overlay=false sync=false &
G=$!

if [ "$AE_MODE" = "fixed" ]; then
    # The ISP turns its own auto exposure back on at start, so it is turned off
    # afterwards.
    sleep 6
    VMAX=$(i2ctransfer -f -y "$BUS" w2@0x1a 0x30 0x28 r3 2>/dev/null | awk '{printf "%d", strtonum($3)*65536+strtonum($2)*256+strtonum($1)}')
    N=$(awk -v u="$AE_FIXED_US" 'BEGIN { printf "%d", u / 7.4074 + 0.5 }')
    v4l2-ctl -d "$ISP" --set-ctrl isp_ae_enable=0 >/dev/null 2>&1
    # V4L2 does not call the driver when the value does not change, and its copy
    # is out of step because the Hailo library writes the registers directly.
    v4l2-ctl -d "$SUBDEV" --set-ctrl exposure=$((N + 1)) >/dev/null 2>&1
    v4l2-ctl -d "$SUBDEV" --set-ctrl exposure=$N >/dev/null 2>&1
    v4l2-ctl -d "$SUBDEV" --set-ctrl analogue_gain=0 >/dev/null 2>&1
    sleep 1
    SHR=$(i2ctransfer -f -y "$BUS" w2@0x1a 0x30 0x50 r3 2>/dev/null | awk '{printf "%d", strtonum($3)*65536+strtonum($2)*256+strtonum($1)}')
    if [ "$SHR" = "$((VMAX - N))" ]; then
        say "fixed exposure $AE_FIXED_US us, verified on the sensor"
    else
        say "WARNING: the fixed exposure did not take, SHR0 is $SHR instead of $((VMAX - N))"
    fi
fi

wait $G 2>/dev/null
