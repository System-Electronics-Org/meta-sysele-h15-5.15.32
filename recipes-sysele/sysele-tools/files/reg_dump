#!/bin/sh
# Dump a block of 32 bit registers, one register per line.
# Usage: reg_dump <hex base> <register count> <output file>
# Example: reg_dump 0x7c018000 128 /tmp/dsi.txt
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }
case "$1" in
-h|--help|"") usage; exit 0 ;;
esac
b=$1; n=$2; out=$3; i=0
: > $out
while [ $i -lt $n ]; do
  o=$((i*4))
  v=$(devmem $((b + o)) 32 2>&1 | tr "\n" " ")
  printf "+0x%03x %s\n" $o "${v:-EMPTY}" >> $out
  i=$((i+1))
done
