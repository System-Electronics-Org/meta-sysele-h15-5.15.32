#!/bin/sh
# State of the DSI video stream generator (VSG), and a VID_EN restart.
# Usage: dsi_status          read only
#        dsi_status fix      clear VID_EN, wait 100 ms, set it again, read back
#        dsi_status rec N    set RECOVERY_MODE in VID_MAIN_CTL and read back
#                            (0 next hsync, the driver default; 2 stop point;
#                            3 next vsync). bridge_enable rewrites it at every
#                            modeset.
rd() { devmem $1 32; }
hist() {
  i=0
  while [ $i -lt $1 ]; do devmem $2 32; i=$((i+1)); done | sort | uniq -c | sort -rn | head -3 | tr "\n" ";"
}
show() {
  v=$(rd 0x7c0180f0)
  if [ $((v & 1)) -eq 1 ]; then g="RUNNING"; else g="STOPPED"; fi
  m=$(rd 0x7c0180b0)
  echo "  uptime $(cut -d' ' -f1 /proc/uptime)  generator $g  DATA_CTL $(rd 0x7c018004)  VID_MODE_STS_FLAG $(rd 0x7c018180)"
  echo "  VID_MAIN_CTL $m  RECOVERY_MODE $(( (m >> 25) & 3 ))"
  echo "  VID_MODE_STS: $(hist 50 0x7c0180f0)"
  echo "  LANE_STS:     $(hist 50 0x7c01802c)"
}

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }
case "$1" in
-h|--help) usage; exit 0 ;;
esac

echo "--- state"
show

case "$1" in
fix)
  d=$(rd 0x7c018004)
  devmem 0x7c018160 32 0xFFFFFFFF
  devmem 0x7c018004 32 $(printf "0x%08X" $((d & ~0x20)))
  usleep 100000 2>/dev/null || sleep 0.1
  devmem 0x7c018004 32 $(printf "0x%08X" $((d | 0x20)))
  sleep 1
  echo "--- after the VID_EN restart"
  show
  ;;
rec)
  case "$2" in 0|2|3) ;; *) echo "dsi_status: rec takes 0, 2 or 3"; exit 1 ;; esac
  m=$(rd 0x7c0180b0)
  devmem 0x7c0180b0 32 $(printf "0x%08X" $(( (m & ~(3 << 25)) | ($2 << 25) )))
  echo "--- after RECOVERY_MODE=$2"
  show
  ;;
esac
