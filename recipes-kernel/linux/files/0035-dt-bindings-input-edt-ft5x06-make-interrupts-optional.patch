From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Riccardo Fiocchi <hwele05@systemelectronics.com>
Date: Fri, 2 Oct 2026 12:00:00 +0200
Subject: [PATCH] dt-bindings: input: edt-ft5x06 - make interrupts optional

Allow controllers without an IRQ line to use the driver polling path.

Upstream-Status: Pending
Signed-off-by: Riccardo Fiocchi <hwele05@systemelectronics.com>
---

diff --git a/Documentation/devicetree/bindings/input/touchscreen/edt-ft5x06.yaml b/Documentation/devicetree/bindings/input/touchscreen/edt-ft5x06.yaml
--- a/Documentation/devicetree/bindings/input/touchscreen/edt-ft5x06.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/edt-ft5x06.yaml
@@ -45,6 +45,7 @@
     maxItems: 1
 
   interrupts:
+    description: Optional when the controller is polled.
     maxItems: 1
 
   reset-gpios:
@@ -99,7 +100,6 @@
 required:
   - compatible
   - reg
-  - interrupts
 
 examples:
   - |
