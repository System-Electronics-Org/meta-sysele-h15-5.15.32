From: System Electronics <info@systemelectronics.com>
Date: Mon, 13 Jul 2026 12:00:00 +0200
Subject: [PATCH] ASoC: wm8960: add opt-in automatic MCLK/PLL selection

Allow boards using simple-audio-card to request the WM8960 automatic
clock-selection mode through the wlf,sysclk-auto device-tree property.

This lets the codec first try the external MCLK directly and fall back
to its internal PLL when that clock cannot generate the requested audio
sample rate.

The behaviour is opt-in and therefore does not affect existing WM8960
users.

Signed-off-by: System Electronics <info@systemelectronics.com>
---
diff --git a/sound/soc/codecs/wm8960.c b/sound/soc/codecs/wm8960.c
index 499604f..01a0694 100644
--- a/sound/soc/codecs/wm8960.c
+++ b/sound/soc/codecs/wm8960.c
@@ -123,12 +123,13 @@ struct wm8960_priv {
 	int (*set_bias_level)(struct snd_soc_component *,
 			      enum snd_soc_bias_level level);
 	struct snd_soc_dapm_widget *lout1;
 	struct snd_soc_dapm_widget *rout1;
 	struct snd_soc_dapm_widget *out3;
 	bool deemph;
+	bool sysclk_auto;
 	int lrclk;
 	int bclk;
 	int sysclk;
 	int clk_id;
 	int freq_in;
 	bool is_stream_in_use[2];
@@ -1287,12 +1288,17 @@ static int wm8960_set_dai_sysclk(struct snd_soc_dai *dai, int clk_id,
 {
 	struct snd_soc_component *component = dai->component;
 	struct wm8960_priv *wm8960 = snd_soc_component_get_drvdata(component);
 
 	switch (clk_id) {
 	case WM8960_SYSCLK_MCLK:
+		if (wm8960->sysclk_auto) {
+			wm8960->freq_in = freq;
+			clk_id = WM8960_SYSCLK_AUTO;
+			break;
+		}
 		snd_soc_component_update_bits(component, WM8960_CLOCK1,
 					0x1, WM8960_SYSCLK_MCLK);
 		break;
 	case WM8960_SYSCLK_PLL:
 		snd_soc_component_update_bits(component, WM8960_CLOCK1,
 					0x1, WM8960_SYSCLK_PLL);
@@ -1410,12 +1416,17 @@ static int wm8960_i2c_probe(struct i2c_client *i2c,
 
 	wm8960 = devm_kzalloc(&i2c->dev, sizeof(struct wm8960_priv),
 			      GFP_KERNEL);
 	if (wm8960 == NULL)
 		return -ENOMEM;
 
+	if (i2c->dev.of_node)
+		wm8960->sysclk_auto =
+			of_property_read_bool(i2c->dev.of_node,
+					      "wlf,sysclk-auto");
+
 	wm8960->mclk = devm_clk_get(&i2c->dev, "mclk");
 	if (IS_ERR(wm8960->mclk)) {
 		if (PTR_ERR(wm8960->mclk) == -EPROBE_DEFER)
 			return -EPROBE_DEFER;
 	}
 
