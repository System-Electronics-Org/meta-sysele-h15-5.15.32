From: System Electronics
Date: Mon, 14 Sep 2026 17:20:00 +0200
Subject: [PATCH] drm/hailo: diagnostic delay before the first scanout

Diagnostic only, inert by default. The kernel parameter
hailo_drm.first_enable_delay_ms=N sleeps N ms once, at the first
hailo_pipe_enable() after probe, before the DPI is configured and its
scanout started. It delays the whole first bring-up of the display chain
relative to the driver probe.

On Astrial H15 the first modeset at boot, done by the console about 10 ms
after this driver probes, leaves the panel black, while a modeset done
later without re-binding the driver works. Whether a delay here is enough
tells whether that time is needed before the DPI starts or only before
video is enabled on the DSI side (see cdns_dsi.video_delay_ms).

No log line on purpose, same reason as 0019. The value in use is in
/sys/module/hailo_drm/parameters/first_enable_delay_ms.

Upstream-Status: Inappropriate [diagnostic, to be removed]

---
--- a/drivers/gpu/drm/hailo/hailo_drv.c
+++ b/drivers/gpu/drm/hailo/hailo_drv.c
@@ -1,4 +1,6 @@
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 
@@ -76,6 +78,7 @@
 	struct clk *dsi_p_clk;
 	struct drm_device drm;
 	struct drm_simple_display_pipe pipe;
+	bool first_enable_done;
 };
 
 DEFINE_DRM_GEM_CMA_FOPS(fops);
@@ -95,6 +98,10 @@
 	DRM_FORMAT_RGB888,
 };
 
+static unsigned int first_enable_delay_ms;
+module_param(first_enable_delay_ms, uint, 0444);
+MODULE_PARM_DESC(first_enable_delay_ms, "Diagnostic: delay in ms before the first scanout after probe");
+
 static void hailo_pipe_enable(struct drm_simple_display_pipe *pipe,
 			      struct drm_crtc_state *crtc_state,
 			      struct drm_plane_state *plane_state)
@@ -108,6 +115,10 @@
 	unsigned long dsi_sys_clk;
 	int refresh;
 
+	if (!priv->first_enable_done && first_enable_delay_ms)
+		msleep(first_enable_delay_ms);
+	priv->first_enable_done = true;
+
 	dsi_sys_clk = clk_get_rate(priv->dsi_sys_clk);
 	refresh = drm_mode_vrefresh(mode);
 	line_size_in_bytes = mode->hdisplay * SUPPORTED_BYTES_PER_PIXEL;
