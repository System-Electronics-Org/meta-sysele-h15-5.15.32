From: System Electronics <support@system-electronics.it>
Subject: [PATCH] drm/panel: trace Raspberry Pi touchscreen lifecycle

Add temporary System Electronics trace prints to identify the last
Raspberry Pi touchscreen callback reached before the Astrial H15
display reset issue.

---
--- a/drivers/gpu/drm/panel/panel-raspberrypi-touchscreen.c
+++ b/drivers/gpu/drm/panel/panel-raspberrypi-touchscreen.c
@@ -42,6 +42,7 @@
  */
 
 #include <linux/delay.h>
+#include <linux/printk.h>
 #include <linux/err.h>
 #include <linux/fb.h>
 #include <linux/i2c.h>
@@ -220,12 +221,14 @@
 
 static int rpi_touchscreen_i2c_read(struct rpi_touchscreen *ts, u8 reg)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_i2c_read ENTER\n");
 	return i2c_smbus_read_byte_data(ts->i2c, reg);
 }
 
 static void rpi_touchscreen_i2c_write(struct rpi_touchscreen *ts,
 				      u8 reg, u8 val)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_i2c_write ENTER\n");
 	int ret;
 
 	ret = i2c_smbus_write_byte_data(ts->i2c, reg, val);
@@ -251,6 +254,7 @@
 
 static int rpi_touchscreen_disable(struct drm_panel *panel)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_disable ENTER\n");
 	struct rpi_touchscreen *ts = panel_to_ts(panel);
 
 	rpi_touchscreen_i2c_write(ts, REG_PWM, 0);
@@ -268,6 +272,7 @@
 
 static int rpi_touchscreen_prepare(struct drm_panel *panel)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_prepare ENTER\n");
 	struct rpi_touchscreen *ts = panel_to_ts(panel);
 	int i;
 
@@ -301,6 +306,7 @@
 
 static int rpi_touchscreen_enable(struct drm_panel *panel)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_enable ENTER\n");
 	struct rpi_touchscreen *ts = panel_to_ts(panel);
 
 	/* Turn on the backlight. */
@@ -319,6 +325,7 @@
 static int rpi_touchscreen_get_modes(struct drm_panel *panel,
 				     struct drm_connector *connector)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_get_modes ENTER\n");
 	unsigned int i, num = 0;
 	static const u32 bus_format = MEDIA_BUS_FMT_RGB888_1X24;
 
@@ -365,6 +372,7 @@
 static int rpi_touchscreen_probe(struct i2c_client *i2c,
 				 const struct i2c_device_id *id)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_probe ENTER\n");
 	struct device *dev = &i2c->dev;
 	struct rpi_touchscreen *ts;
 	struct device_node *endpoint, *dsi_host_node;
@@ -473,6 +481,7 @@
 
 static int rpi_touchscreen_remove(struct i2c_client *i2c)
 {
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_remove ENTER\n");
 	struct rpi_touchscreen *ts = i2c_get_clientdata(i2c);
 
 	mipi_dsi_detach(ts->dsi);
