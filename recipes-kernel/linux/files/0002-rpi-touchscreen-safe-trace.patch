From: System Electronics <support@system-electronics.it>
Subject: [PATCH] drm/panel: add safe Raspberry Pi touchscreen trace

Add temporary declaration-safe trace prints around the Raspberry Pi
touchscreen lifecycle and I2C accesses.

---
--- a/drivers/gpu/drm/panel/panel-raspberrypi-touchscreen.c
+++ b/drivers/gpu/drm/panel/panel-raspberrypi-touchscreen.c
@@ -42,6 +42,7 @@
  */
 
 #include <linux/delay.h>
+#include <linux/printk.h>
 #include <linux/err.h>
 #include <linux/fb.h>
 #include <linux/i2c.h>
@@ -220,7 +221,13 @@
 
 static int rpi_touchscreen_i2c_read(struct rpi_touchscreen *ts, u8 reg)
 {
-	return i2c_smbus_read_byte_data(ts->i2c, reg);
+	int ret;
+
+	pr_err("SYSELE_RPI_TRACE: i2c_read reg=0x%02x ENTER\n", reg);
+	ret = i2c_smbus_read_byte_data(ts->i2c, reg);
+	pr_err("SYSELE_RPI_TRACE: i2c_read reg=0x%02x ret=%d\n", reg, ret);
+
+	return ret;
 }
 
 static void rpi_touchscreen_i2c_write(struct rpi_touchscreen *ts,
@@ -228,6 +235,7 @@
 {
 	int ret;
 
+	pr_err("SYSELE_RPI_TRACE: i2c_write reg=0x%02x val=0x%02x ENTER\n", reg, val);
 	ret = i2c_smbus_write_byte_data(ts->i2c, reg, val);
 	if (ret)
 		dev_err(&ts->dsi->dev, "I2C write failed: %d\n", ret);
@@ -253,6 +261,7 @@
 {
 	struct rpi_touchscreen *ts = panel_to_ts(panel);
 
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_disable ENTER\n");
 	rpi_touchscreen_i2c_write(ts, REG_PWM, 0);
 
 	rpi_touchscreen_i2c_write(ts, REG_POWERON, 0);
@@ -271,6 +280,7 @@
 	struct rpi_touchscreen *ts = panel_to_ts(panel);
 	int i;
 
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_prepare ENTER\n");
 	rpi_touchscreen_i2c_write(ts, REG_POWERON, 1);
 	/* Wait for nPWRDWN to go low to indicate poweron is done. */
 	for (i = 0; i < 100; i++) {
@@ -304,6 +314,7 @@
 	struct rpi_touchscreen *ts = panel_to_ts(panel);
 
 	/* Turn on the backlight. */
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_enable ENTER\n");
 	rpi_touchscreen_i2c_write(ts, REG_PWM, 255);
 
 	/* Default to the same orientation as the closed source
@@ -320,6 +331,7 @@
 				     struct drm_connector *connector)
 {
 	unsigned int i, num = 0;
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_get_modes ENTER\n");
 	static const u32 bus_format = MEDIA_BUS_FMT_RGB888_1X24;
 
 	for (i = 0; i < ARRAY_SIZE(rpi_touchscreen_modes); i++) {
@@ -377,6 +389,7 @@
 		.node = NULL,
 	};
 
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_probe ENTER\n");
 	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
 	if (!ts)
 		return -ENOMEM;
@@ -475,6 +488,7 @@
 {
 	struct rpi_touchscreen *ts = i2c_get_clientdata(i2c);
 
+	pr_err("SYSELE_RPI_TRACE: rpi_touchscreen_remove ENTER\n");
 	mipi_dsi_detach(ts->dsi);
 
 	drm_panel_remove(&ts->base);
