From: System Electronics
Date: Wed, 16 Sep 2026 11:40:00 +0200
Subject: [PATCH] drm/bridge: cdns-dsi: declare negative syncs and DE high

The controller reads frame boundaries from DE and the sync signals and
expects negative syncs with DE high, but nothing in the chain says so: the
panel declares no sync polarity at all, so the mode carries flags 0 and
the requirement stays implicit.

Backport of Tomi Valkeinen's "drm/bridge: cdns-dsi: Fix mode and bus
flags". The bridge here still uses the legacy hooks, so the atomic state
helpers come with it, otherwise the check would never run.

The DPI driver on this SoC ignores bus flags, so on this board nothing
changes today. It is in for the alignment and to make the requirement
explicit where a reader will look for it.

Upstream-Status: Backport

---
--- a/drivers/gpu/drm/bridge/cdns-dsi.c
+++ b/drivers/gpu/drm/bridge/cdns-dsi.c
@@ -6,6 +6,7 @@
  */
 
 #include <drm/drm_atomic_helper.h>
+#include <drm/drm_atomic_state_helper.h>
 #include <drm/drm_bridge.h>
 #include <drm/drm_drv.h>
 #include <drm/drm_mipi_dsi.h>
@@ -1172,6 +1173,24 @@
 	pm_runtime_put_sync_suspend(dsi->base.dev);
 }
 
+static int cdns_dsi_bridge_atomic_check(struct drm_bridge *bridge,
+					struct drm_bridge_state *bridge_state,
+					struct drm_crtc_state *crtc_state,
+					struct drm_connector_state *conn_state)
+{
+	struct drm_display_mode *adjusted_mode = &crtc_state->adjusted_mode;
+
+	/* The controller wants negative syncs and DE high. */
+	adjusted_mode->flags &= ~(DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC);
+	adjusted_mode->flags |= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC;
+
+	bridge_state->input_bus_cfg.flags = DRM_BUS_FLAG_DE_HIGH |
+					    DRM_BUS_FLAG_PIXDATA_DRIVE_POSEDGE |
+					    DRM_BUS_FLAG_SYNC_DRIVE_POSEDGE;
+
+	return 0;
+}
+
 static const struct drm_bridge_funcs cdns_dsi_bridge_funcs = {
 	.attach = cdns_dsi_bridge_attach,
 	.mode_valid = cdns_dsi_bridge_mode_valid,
@@ -1179,6 +1198,10 @@
 	.pre_enable = cdns_dsi_bridge_pre_enable,
 	.enable = cdns_dsi_bridge_enable,
 	.post_disable = cdns_dsi_bridge_post_disable,
+	.atomic_check = cdns_dsi_bridge_atomic_check,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_reset = drm_atomic_helper_bridge_reset,
 };
 
 static int cdns_dsi_attach(struct mipi_dsi_host *host,
